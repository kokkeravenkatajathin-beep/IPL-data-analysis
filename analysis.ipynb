   },import pandas as pd
import matplotlib.pyplot as plt

# Load dataset
df = pd.read_csv("ipl.csv")

print(df.head())


# 1. Most matches won (Pie Chart)
if 'Match_Winner' in df.columns:
    winner_counts = df['Match_Winner'].value_counts().head(10)
    explode = [0.1] * len(winner_counts)

    plt.figure(figsize=(8, 8))
    winner_counts.plot(
        kind='pie',
        explode=explode,
        shadow=True,
        autopct='%0.1f%%',
        labels=None
    )

    plt.title("Top Winning Teams")
    plt.ylabel("")

    plt.legend(
        winner_counts.index,
        loc="center left",
        bbox_to_anchor=(1, 0.5),
        fontsize=12
    )

    plt.tight_layout()
    plt.show()


# 2. Matches per city (Bar + Line Combo)
if 'Venue' in df.columns:
    city_counts = df['Venue'].value_counts().head(10).sort_values()

    plt.figure(figsize=(8, 5))
    plt.grid(True, linestyle='--', alpha=0.5)
    plt.gca().set_axisbelow(True)

    plt.bar(city_counts.index, city_counts.values)
    plt.plot(city_counts.index, city_counts.values, marker='o', color="red")

    for i, v in enumerate(city_counts.values):
        plt.text(i, v + 1, str(v), ha='center')

    plt.title("Matches by Venue")
    plt.xlabel("Venue")
    plt.ylabel("Matches")
    plt.xticks(rotation=45)

    plt.tight_layout()
    plt.show()


# 3. Toss winner analysis
if 'Toss_Winner' in df.columns:
    toss_counts = df['Toss_Winner'].value_counts().head(10).sort_values()

    plt.figure(figsize=(8, 5))
    plt.grid(True, linestyle='--', alpha=0.5)
    plt.gca().set_axisbelow(True)

    toss_counts.plot(kind='bar')

    for i, v in enumerate(toss_counts.values):
        plt.text(i, v + 1, str(v), ha='center')

    plt.title("Toss Winners")
    plt.xlabel("Teams")
    plt.ylabel("Count")
    plt.xticks(rotation=45)

    plt.tight_layout()
    plt.show()


# 4. Top 5 Teams (separate clean chart)
if 'Match_Winner' in df.columns:
    top5 = df['Match_Winner'].value_counts().head(5)

    plt.figure(figsize=(6, 4))
    top5.plot(kind='barh')

    plt.title("Top 5 Teams")
    plt.xlabel("Wins")
    plt.ylabel("Teams")

    plt.tight_layout()
    plt.show()
